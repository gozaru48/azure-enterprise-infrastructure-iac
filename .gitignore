# Local .terraform directories
# Contains downloaded providers and modules.
.terraform/

# .tfstate files
# Contains sensitive infrastructure information and secrets.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
# These are likely to contain sensitive data such as passwords or API keys.
*.tfvars
*.tfvars.json

# Ignore the terraform binary
# Large binary files should not be stored in Git.
terraform.exe

# Ignore lock file for a cleaner repository (optional)
# Some teams commit this, but for personal learning portfolios, 
# it's often cleaner to exclude it.
.terraform.lock.hcl